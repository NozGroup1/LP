<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NozGroup — Proposta Comercial</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Barlow:wght@300;400;500;600;700;800&family=Barlow+Condensed:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --red: #8B0000;
    --red-mid: #A50000;
    --red-bright: #C0001A;
    --black: #0A0A0A;
    --gray-dark: #1A1A1A;
    --gray-mid: #2C2C2C;
    --gray-light: #3D3D3D;
    --silver: #7A7A7A;
    --white: #F5F0EB;
    --white-pure: #FFFFFF;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'Barlow', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    cursor: default;
  }

  /* ── NOISE OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: .35;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    position: relative;
    overflow: hidden;
    padding: 0 6vw;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--black));
    z-index: 2;
  }

  /* Red diagonal slab */
  .hero-slab {
    position: absolute;
    top: 0; right: -5%;
    width: 48%;
    height: 100%;
    background: linear-gradient(160deg, var(--red) 0%, var(--red-mid) 60%, #3D0000 100%);
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0% 100%);
    z-index: 0;
  }

  .hero-slab::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 20px,
      rgba(0,0,0,.07) 20px,
      rgba(0,0,0,.07) 21px
    );
  }

  /* Top bar */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.4rem 0;
    position: relative;
    z-index: 10;
    animation: fadeDown .8s ease both;
  }

  .logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--white-pure);
  }

  .logo span {
    color: var(--red-bright);
  }

  .badge {
    border: 1px solid rgba(255,255,255,.15);
    padding: .45rem 1.1rem;
    font-size: .7rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--silver);
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(8px);
  }

  /* Hero content */
  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 10;
    padding: 4rem 0 6rem;
  }

  .eyebrow {
    font-size: .72rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--red-bright);
    margin-bottom: 1.6rem;
    animation: fadeUp .8s .2s ease both;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: clamp(3.2rem, 7vw, 7rem);
    line-height: .95;
    max-width: 640px;
    animation: fadeUp .8s .35s ease both;
  }

  .hero-title em {
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,.5);
  }

  .hero-sub {
    margin-top: 2rem;
    max-width: 420px;
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(245,240,235,.6);
    animation: fadeUp .8s .5s ease both;
  }

  .hero-cta {
    margin-top: 3rem;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    animation: fadeUp .8s .65s ease both;
  }

  .btn-primary {
    background: var(--red);
    color: var(--white-pure);
    padding: 1rem 2.4rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: .9rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: background .3s;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.12) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform .5s;
  }

  .btn-primary:hover { background: var(--red-bright); }
  .btn-primary:hover::after { transform: translateX(100%); }

  .hero-scroll {
    font-size: .68rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--silver);
    display: flex;
    align-items: center;
    gap: .6rem;
  }

  .hero-scroll::before {
    content: '';
    display: block;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--red-bright), transparent);
    animation: scrollLine 1.5s ease-in-out infinite;
  }

  /* Hero bottom */
  .hero-bottom {
    position: relative;
    z-index: 10;
    padding-bottom: 3rem;
    display: flex;
    gap: 4rem;
    animation: fadeUp .8s .8s ease both;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }

  .stat-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 2.2rem;
    color: var(--white-pure);
    line-height: 1;
  }

  .stat-label {
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--silver);
  }

  /* ── INTRO STRIP ── */
  .strip {
    background: var(--red);
    padding: 1.2rem 6vw;
    display: flex;
    align-items: center;
    gap: 3rem;
    overflow: hidden;
    position: relative;
  }

  .strip-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: .78rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255,255,255,.85);
  }

  .strip-dot {
    width: 4px;
    height: 4px;
    background: rgba(255,255,255,.4);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── SECTION COMMONS ── */
  .section {
    padding: 8rem 6vw;
    position: relative;
  }

  .section-label {
    font-size: .68rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--red-bright);
    margin-bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-label::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--red-bright);
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1.05;
    max-width: 640px;
  }

  /* ── PROBLEM SECTION ── */
  .problem {
    background: var(--gray-dark);
  }

  .problem-grid {
    margin-top: 5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .problem-card {
    background: var(--gray-mid);
    padding: 3rem 2.5rem;
    position: relative;
    overflow: hidden;
    transition: background .3s;
  }

  .problem-card:hover { background: var(--gray-light); }

  .problem-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--red), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .4s;
  }

  .problem-card:hover::before { transform: scaleX(1); }

  .problem-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 4rem;
    color: rgba(255,255,255,.05);
    line-height: 1;
    margin-bottom: 1.5rem;
    transition: color .3s;
  }

  .problem-card:hover .problem-num { color: rgba(139,0,0,.25); }

  .problem-text {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(245,240,235,.7);
  }

  .problem-text strong {
    color: var(--white-pure);
    font-weight: 600;
  }

  /* ── PLANS SECTION ── */
  .plans {
    background: var(--black);
  }

  .plans-grid {
    margin-top: 5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    position: relative;
  }

  /* plan card */
  .plan {
    background: var(--gray-dark);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform .4s cubic-bezier(.25,.8,.25,1);
  }

  .plan:hover { transform: translateY(-6px); z-index: 5; }

  .plan-featured {
    background: var(--gray-mid);
    transform: scale(1.02);
    z-index: 3;
    box-shadow: 0 0 0 2px var(--red), 0 40px 80px rgba(139,0,0,.3);
  }

  .plan-featured:hover { transform: scale(1.02) translateY(-6px); }

  .plan-header {
    padding: 3rem 2.8rem 2.5rem;
    position: relative;
  }

  .plan-featured .plan-header {
    background: linear-gradient(135deg, var(--red) 0%, #5C0000 100%);
  }

  .plan-tier {
    font-size: .65rem;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: rgba(255,255,255,.5);
    margin-bottom: .8rem;
  }

  .plan-featured .plan-tier {
    color: rgba(255,255,255,.7);
  }

  .plan-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 2.2rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: .6rem;
  }

  .plan-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: rgba(245,240,235,.6);
    margin-bottom: 2rem;
  }

  .plan-featured .plan-tagline { color: rgba(255,255,255,.8); }

  .plan-price-block {
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }

  .plan-price-label {
    font-size: .65rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(255,255,255,.4);
  }

  .plan-featured .plan-price-label { color: rgba(255,255,255,.6); }

  .plan-price {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--white-pure);
  }

  .plan-price-note {
    font-size: .75rem;
    color: rgba(245,240,235,.5);
    margin-top: .3rem;
  }

  .plan-featured .plan-price-note { color: rgba(255,255,255,.65); }

  .plan-divider {
    height: 1px;
    background: rgba(255,255,255,.06);
    margin: 0 2.8rem;
  }

  .plan-featured .plan-divider { background: rgba(255,255,255,.12); }

  .plan-body {
    padding: 2.5rem 2.8rem 3rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .feature-group {
    display: flex;
    flex-direction: column;
    gap: .85rem;
  }

  .feature-group-label {
    font-size: .62rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--red-bright);
    padding-bottom: .4rem;
    border-bottom: 1px solid rgba(139,0,0,.25);
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    font-size: .9rem;
    line-height: 1.6;
    color: rgba(245,240,235,.75);
  }

  .feature-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: .15rem;
    position: relative;
  }

  .feature-icon::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    width: 6px;
    height: 6px;
    background: var(--red-bright);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  .plan-featured .feature { color: rgba(245,240,235,.85); }

  .plan-footer {
    padding: 0 2.8rem 3rem;
  }

  .plan-btn {
    width: 100%;
    padding: 1.1rem 2rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: .85rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    border: 1px solid rgba(255,255,255,.15);
    background: transparent;
    color: rgba(255,255,255,.7);
    cursor: pointer;
    transition: all .3s;
    text-align: center;
    display: block;
    text-decoration: none;
  }

  .plan-btn:hover {
    background: rgba(255,255,255,.05);
    color: var(--white-pure);
    border-color: rgba(255,255,255,.3);
  }

  .plan-btn-featured {
    background: var(--white-pure);
    color: var(--red);
    border-color: var(--white-pure);
  }

  .plan-btn-featured:hover {
    background: var(--white);
    color: var(--red-bright);
    border-color: var(--white);
  }

  .plan-badge {
    position: absolute;
    top: 2rem;
    right: 2.8rem;
    background: var(--black);
    color: var(--white-pure);
    font-size: .6rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    padding: .35rem .8rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
  }

  /* ── COMPARISON TABLE ── */
  .compare {
    background: var(--gray-dark);
  }

  .compare-table {
    margin-top: 4rem;
    width: 100%;
    border-collapse: collapse;
  }

  .compare-table th, .compare-table td {
    padding: 1.2rem 1.8rem;
    text-align: left;
    font-size: .88rem;
    border-bottom: 1px solid rgba(255,255,255,.06);
  }

  .compare-table thead th {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--silver);
    background: var(--gray-mid);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .compare-table thead th:first-child {
    background: var(--gray-mid);
    color: rgba(255,255,255,.4);
  }

  .compare-table thead th.col-featured {
    background: var(--red);
    color: var(--white-pure);
  }

  .compare-table tbody tr:hover td { background: rgba(255,255,255,.02); }

  .compare-table td:first-child {
    color: rgba(245,240,235,.6);
    font-size: .85rem;
  }

  .compare-table td.col-featured {
    background: rgba(139,0,0,.06);
  }

  .check {
    color: var(--red-bright);
    font-size: 1rem;
  }

  .dash {
    color: rgba(255,255,255,.15);
  }

  /* ── PROCESS ── */
  .process {
    background: var(--black);
  }

  .process-steps {
    margin-top: 5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
  }

  .process-steps::before {
    content: '';
    position: absolute;
    top: 2.2rem;
    left: calc(12.5% + 1.5rem);
    right: calc(12.5% + 1.5rem);
    height: 1px;
    background: linear-gradient(90deg, var(--red), rgba(139,0,0,.1) 50%, var(--red));
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.5rem;
    gap: 1.5rem;
  }

  .step-dot {
    width: 4.5rem;
    height: 4.5rem;
    background: var(--gray-dark);
    border: 2px solid var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  .step-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--red-bright);
  }

  .step-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--white-pure);
  }

  .step-desc {
    font-size: .82rem;
    line-height: 1.7;
    color: rgba(245,240,235,.55);
  }

  /* ── CTA SECTION ── */
  .cta-section {
    background: var(--red);
    padding: 8rem 6vw;
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 60%;
    height: 200%;
    background: radial-gradient(ellipse at center, rgba(0,0,0,.3) 0%, transparent 70%);
  }

  .cta-section::after {
    content: 'NOZGROUP';
    position: absolute;
    bottom: -3rem;
    right: -1rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 12rem;
    color: rgba(255,255,255,.04);
    letter-spacing: -.02em;
    pointer-events: none;
    line-height: 1;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .cta-text .section-label { color: rgba(255,255,255,.7); }
  .cta-text .section-label::before { background: rgba(255,255,255,.7); }

  .cta-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 1;
    color: var(--white-pure);
    max-width: 560px;
  }

  .cta-title em {
    font-style: italic;
    color: rgba(255,255,255,.7);
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    flex-shrink: 0;
  }

  .btn-white {
    background: var(--white-pure);
    color: var(--red);
    padding: 1.1rem 3rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: .95rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background .3s;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .btn-white:hover { background: var(--white); }

  .cta-note {
    font-size: .72rem;
    color: rgba(255,255,255,.6);
    letter-spacing: .1em;
    text-align: center;
  }

  /* ── FOOTER ── */
  footer {
    background: var(--gray-dark);
    padding: 4rem 6vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--white-pure);
  }

  .footer-logo span { color: var(--red-bright); }

  .footer-copy {
    font-size: .72rem;
    letter-spacing: .12em;
    color: var(--silver);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollLine {
    0%, 100% { opacity: 1; }
    50% { opacity: .3; }
  }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity .8s ease, transform .8s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 { transition-delay: .15s; }
  .reveal-delay-2 { transition-delay: .3s; }
  .reveal-delay-3 { transition-delay: .45s; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .problem-grid, .plans-grid, .process-steps {
      grid-template-columns: 1fr;
    }
    .plan-featured { transform: scale(1); }
    .plan-featured:hover { transform: translateY(-6px); }
    .plan-badge { top: 1.5rem; }
    .process-steps::before { display: none; }
    .step { flex-direction: row; text-align: left; }
    .compare-table { font-size: .8rem; }
    .compare-table th, .compare-table td { padding: .8rem 1rem; }
    .cta-inner { flex-direction: column; }
    .hero-bottom { gap: 2.5rem; }
    .hero-slab { width: 100%; clip-path: none; opacity: .12; }
  }
</style>
